# Copy to .env and use absolute paths for this machine.

# Existing MIDAS installation containing bin/, include/, and lib/.
export MIDASSYS=/absolute/path/to/midas

# Apptainer image containing ROOT, Gaudi, and the PIONEER build toolchain.
export PIONEER_GAUDI_IMAGE=/absolute/path/to/pioneer-gaudi.sif


# Optional: build a clean MIDAS dependency inside the Gaudi container when the
# host MIDAS exports host-specific ROOT/Conda paths. Requires a source checkout
# with its MIDAS submodules initialized; the original checkout is not modified.
# export PIONEER_GAUDI_MIDAS_SOURCE=/absolute/path/to/midas-source
